#!/usr/bin/env bash
# Configure localhost and facebook.com IP address mappings
sed -e '/[[:space:]]localhost\([[:space:]]\|$\)/d' \
    -e '/[[:space:]]facebook\.com\([[:space:]]\|$\)/d' \
    /etc/hosts > /tmp/hosts_network_backup
cat /tmp/hosts_network_backup > /etc/hosts
echo "127.0.0.2 localhost" >> /etc/hosts
echo "8.8.8.8 facebook.com" >> /etc/hosts
